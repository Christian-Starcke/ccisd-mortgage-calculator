# The Clear Creek ISD parcel footprint, held in Supabase.
#
# Read server-side only, from the API routes, so the key never reaches the
# browser. The `parcel` table is public and read-only under row-level security,
# so the publishable key is all the app needs.
#
# Without these the calculator still runs: the address lookup is disabled and it
# falls back to the location presets, and says so.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Only scripts/ingestParcels.mjs needs write access, and only when refreshing
# the annual appraisal-district drops. The app never uses this. Do not put it in
# the deployed environment.
# SUPABASE_SERVICE_KEY=
